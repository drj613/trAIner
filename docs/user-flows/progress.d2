...@style
# Sources: HistoryClient, HistoryDrawer, HistoryExportPanel, ProfileClient, LibraryClient.
menu: "Navigation menu\n\nReview training progress" {class: screen}
history: "History · movement families" {
  class: screenshot
  icon: screenshots/mobile-light/history.png
}
versions: "Movement and version history\n\nExpand family and version\nInspect recorded sessions" {class: screen}
workout: "Workout · open exercise history" {
  class: screenshot
  icon: screenshots/mobile-light/workout.png
}
export: "Export history · preview for external AI" {
  class: screenshot
  icon: screenshots/mobile-light/history-export.png
}
empty: "No matching history\n\nChange search or filters\nLog workouts to add history" {class: recovery}
profile: "Profile · goals, bodyweight and training" {
  class: screenshot
  icon: screenshots/mobile-light/profile.png
}
library: "Library · search catalog movements" {
  class: screenshot
  icon: screenshots/mobile-light/library.png
}
external: "External AI conversation\n\nUse exported history as context\nfor training advice" {class: external}
menu -> history
history -> versions: Expand
history -> empty: No matches or no logs
empty -> history: Adjust filters or return after logging
history -> export: Export
export -> external: Copy or download then share
workout -> drawer: Exercise history drawer
menu -> profile
menu -> library

drawer: "Exercise history · previous sessions" {
  class: screenshot
  icon: screenshots/mobile-light/exercise-history.png
}
drawer -> workout: Close drawer
