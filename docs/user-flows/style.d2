# Shared appearance. Journey files contain the behavior, not layout coordinates.
direction: down
classes: {
  screen: {
    style: {
      fill: "#FFFFFF"
      stroke: "#94A3B8"
      border-radius: 12
      font-color: "#0F172A"
      font-size: 17
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#FEF3C7"
      stroke: "#B45309"
      font-color: "#78350F"
      font-size: 16
    }
  }
  external: {
    style: {
      fill: "#F3E8FF"
      stroke: "#9333EA"
      stroke-dash: 5
      border-radius: 12
      font-color: "#581C87"
    }
  }
  recovery: {
    style: {
      fill: "#FFF1F2"
      stroke: "#E11D48"
      border-radius: 12
      font-color: "#881337"
    }
  }
  outcome: {
    style: {
      fill: "#DCFCE7"
      stroke: "#16A34A"
      border-radius: 12
      font-color: "#14532D"
    }
  }
}
